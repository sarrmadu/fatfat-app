# Copiez ce fichier en .env et remplissez les valeurs réelles.

PORT=4000

# Chaîne de connexion PostgreSQL (doit pointer vers une base avec l'extension PostGIS activable).
# Exemple local : postgresql://logiroute:motdepasse@localhost:5432/logiroute
# Exemple hébergé (Supabase/Railway/Neon) : fourni par votre fournisseur
DATABASE_URL=postgresql://logiroute:logiroute@localhost:5432/logiroute

# Secret utilisé pour signer les tokens JWT — à changer impérativement en production.
JWT_SECRET=change-moi-en-production
JWT_EXPIRES_IN=12h

# Mot de passe commun utilisé par le script de seed pour tous les comptes de démo.
SEED_PASSWORD=demo1234
